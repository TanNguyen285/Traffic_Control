        <mxCell id="zvTdW2XHT6xRna0pAbf5-26" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=20;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;font color=&quot;#303030&quot; face=&quot;Google Sans Text&quot;&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;$$\begin{array}{|l|}&lt;br/&gt;\hline&lt;br/&gt;\mathbf{z}_c = \frac{1}{H \times W} \sum_{i=1}^{H} \sum_{j=1}^{W} u_{c}(i,j) \\ &lt;br/&gt;\mathbf{s} = \sigma(\mathbf{W}_2 \ \text{ReLU}(\mathbf{W}_1 \mathbf{z})) \\ &lt;br/&gt;\widetilde{\mathbf{x}}_c = s_c \cdot \mathbf{u}_c \\&lt;br/&gt;\hline&lt;br/&gt;\bullet \ \mathbf{u}_c : \text{Kênh đặc trưng thứ } c \text{ của đầu vào } \mathbf{U} \\&lt;br/&gt;\bullet \ \mathbf{z}_c : \text{Giá trị nén toàn cục (Squeeze) của kênh } c \\&lt;br/&gt;\bullet \ \mathbf{W}_1, \mathbf{W}_2 : \text{Trọng số các lớp FC (Giảm và tăng chiều)} \\&lt;br/&gt;\bullet \ s_c : \text{Trọng số quan trọng (Attention score) của kênh } c \\&lt;br/&gt;\bullet \ \sigma : \text{Hàm Sigmoid giới hạn trọng số trong khoảng [0, 1]} \\&lt;br/&gt;\bullet \ \cdot : \text{Phép nhân vô hướng theo từng kênh} \\&lt;br/&gt;\hline&lt;br/&gt;\end{array}$$&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="290" width="508.94" x="40" y="31.8" as="geometry" />
        </mxCell>
        <mxCell id="UBCmiKnaOXTys4WL3lNs-455" parent="1" style="swimlane;whiteSpace=wrap;html=1;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;startSize=50;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=20;" value="&lt;font&gt;GLKA_Anpha&lt;/font&gt;" vertex="1">
