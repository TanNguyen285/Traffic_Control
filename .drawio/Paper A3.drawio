        <mxCell id="ASVw2VURl4B2cSRPTykd-84" parent="ASVw2VURl4B2cSRPTykd-91" style="text;html=1;fontSize=24;fontStyle=1;verticalAlign=middle;align=center;fillColor=#b0e3e6;strokeColor=#999999;rounded=1;swimlaneLine=1;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Neck" vertex="1">
