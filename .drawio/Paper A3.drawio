        <mxCell id="HQc-9dvZf1E8jSN_aEHi-223" edge="1" parent="1" source="HQc-9dvZf1E8jSN_aEHi-218" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;shape=flexArrow;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" target="HQc-9dvZf1E8jSN_aEHi-221">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HQc-9dvZf1E8jSN_aEHi-224" edge="1" parent="1" source="HQc-9dvZf1E8jSN_aEHi-222" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;shape=flexArrow;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" target="HQc-9dvZf1E8jSN_aEHi-219">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w8FvoX1UMnfHgoO-SPEi-7" parent="1" style="text;whiteSpace=wrap;fontSize=18;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="$$\begin{array}{|l|}&#xa;\hline&#xa;\text{Attn} = \text{Conv}_{1 \times 1}(\text{DW-D-Conv}(\text{DW-Conv}(\mathbf{F}))) \\ &#xa;\mathbf{F}_{out} = \text{Attn} \otimes \mathbf{F} \\&#xa;\hline&#xa;\bullet \ \mathbf{F} : \text{Bản đồ đặc trưng đầu vào (Feature map)} \\&#xa;\bullet \ \text{DW-Conv} : \text{Tích chập Depth-wise học thông tin cục bộ} \\&#xa;\bullet \ \text{DW-D-Conv} : \text{Tích chập Depth-wise Dilated học tầm xa} \\&#xa;\bullet \ \text{Attn} : \text{Bản đồ chú ý không gian (Spatial attention map)} \\&#xa;\bullet \ \text{Conv}_{1 \times 1} : \text{Tích chập điểm giúp thiết lập mối quan hệ kênh} \\&#xa;\bullet \ \otimes : \text{Phép nhân Hadamard (Element-wise product)} \\&#xa;\hline&#xa;\end{array}$$" vertex="1">
          <mxGeometry height="265.2" width="570.97" x="-743.97" y="38.46000000000001" as="geometry" />
        </mxCell>
        <mxCell id="w8FvoX1UMnfHgoO-SPEi-9" parent="1" style="text;whiteSpace=wrap;fontSize=19;fontFamily=Times New Roman;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="$$\begin{array}{l}&#xa;\text{- Vai trò: Thực hiện cơ chế chú ý kênh (Channel Attention) để tái cấu trúc} \\&#xa;\text{tầm quan trọng của các đặc trưng dựa trên mối quan hệ phụ thuộc lẫn nhau.} \\&#xa;\text{- Tại sao xây dựng như vậy: Tích chập truyền thống kết hợp thông tin không gian} \\&#xa;\text{và kênh một cách cứng nhắc. SE cho phép mạng tự thích nghi bằng cách} \\&#xa;\text{gán trọng số cao cho kênh hữu ích và ức chế các kênh nhiễu.} \\&#xa;\text{- Cấu trúc Bottleneck (W1, W2): Giúp giảm độ phức tạp tính toán thông qua} \\&#xa;\text{tỷ lệ giảm (reduction ratio r), đồng thời giới hạn mô hình không bị quá khớp.} \\&#xa;\end{array}$$" vertex="1">
          <mxGeometry height="218.2" width="710.53" x="35" y="310.8" as="geometry" />
        </mxCell>
        <mxCell id="w8FvoX1UMnfHgoO-SPEi-11" parent="1" style="text;whiteSpace=wrap;fontSize=18;fontFamily=Times New Roman;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="$$\begin{array}{l}&#xa;\text{- Ý tưởng: Mô phỏng cơ chế Self-Attention của Transformer bằng cách phân rã} \\&#xa;\text{ma trận chú ý thành các lớp tích chập có tính toán tuyến tính.} \\&#xa;\text{- Tại sao xây dựng như vậy: Self-Attention truyền thống có độ phức tạp bình phương} \\&#xa;\text{và bỏ qua cấu trúc 2D của ảnh. LKA khắc phục bằng cách chia nhân lớn thành} \\&#xa;\text{ba thành phần: cục bộ (local), tầm xa (long-range) và kênh (channel).} \\&#xa;\text{- Hiệu quả: Cung cấp khả năng thích nghi không gian (Spatial adaptability)} \\&#xa;\text{với chi phí lưu trữ và tính toán thấp hơn nhiều so với nhân lớn thông thường.} \\&#xa;\end{array}$$" vertex="1">
          <mxGeometry height="219.7" width="730.97" x="-743.97" y="293.96000000000004" as="geometry" />
        </mxCell>
        <mxCell id="w8FvoX1UMnfHgoO-SPEi-12" parent="1" style="text;whiteSpace=wrap;html=1;align=center;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;Large Kernel Attention (LKA)&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="76.34" width="190" x="-182.42" y="10" as="geometry" />
        </mxCell>
        <mxCell id="w8FvoX1UMnfHgoO-SPEi-13" parent="1" style="text;whiteSpace=wrap;html=1;align=center;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;Squeeze-and-Excitation (SE Block)&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="435.97" x="35" y="15.000000000000002" as="geometry" />
        </mxCell>
        <mxCell id="w8FvoX1UMnfHgoO-SPEi-21" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;imageBorder=default;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="188.43" width="785.97" x="-750.97" y="513.66" as="geometry" />
        </mxCell>
        <mxCell id="w8FvoX1UMnfHgoO-SPEi-22" parent="1" style="text;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=18;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="$$\begin{array}{|l|}&#xa;\hline&#xa;\text{Cơ chế thiết kế (Training Phase)} \\&#xa;\hline&#xa;\text{1. Nhánh chính: Large Kernel Conv } (K \times K) \\&#xa;\text{2. Nhánh bổ trợ: Các nhân nhỏ } (k \times k) \text{ song song với độ giãn } r \\&#xa;\text{Điều kiện ràng buộc: } (k - 1)r + 1 \leq K \\&#xa;\hline&#xa;\text{Cơ chế gộp (Inference Stage - Reparam)} \\&#xa;\hline&#xa;\text{Bước 1: Merge BN } \rightarrow \text{ Gộp Batch Norm vào lớp Conv đứng trước.} \\&#xa;\text{Bước 2: Dilation to Sparse } \rightarrow \text{ Chuyển nhân giãn } k \text{ thành nhân thưa kích thước } k_{equiv}. \\&#xa;\text{Bước 3: Zero-padding } \rightarrow \text{ Bù viền 0 để tất cả nhân nhỏ bằng kích thước } K \times K. \\&#xa;\text{Bước 4: Add up } \rightarrow \text{ Cộng tất cả các ma trận trọng số lại với nhau.} \\&#xa;\hline&#xa;\end{array}$$" vertex="1">
          <mxGeometry height="266.04" width="708.97" x="-748.97" y="693.96" as="geometry" />
        </mxCell>
        <mxCell id="w8FvoX1UMnfHgoO-SPEi-267" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=60;fillColor=#d5e8d4;strokeColor=#82b366;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;Đèn xanh (Kẹt)&lt;/font&gt;" vertex="1">
