        <mxCell id="Fm8s69UgA1QuTbbXPGXl-1" parent="1" style="text;whiteSpace=wrap;html=1;align=center;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;UniRepLKNet&lt;/font&gt;&lt;/b&gt;" vertex="1">
