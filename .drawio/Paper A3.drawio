        </mxCell>
        <mxCell id="ASVw2VURl4B2cSRPTykd-85" parent="ASVw2VURl4B2cSRPTykd-91" style="text;html=1;fontSize=24;fontStyle=1;verticalAlign=middle;align=center;fillColor=#b0e3e6;strokeColor=#999999;rounded=1;swimlaneLine=1;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Head" vertex="1">
          <mxGeometry height="38.32666666666667" width="142.51409395973158" x="1193.8000000000002" y="14.370000000000118" as="geometry" />
        </mxCell>
        <mxCell id="42HpZ1UBDPzv6tWb8ubM-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;font style=&quot;font-size: 25px;&quot;&gt;Mô hình đạt hiệu năng &lt;b data-path-to-node=&quot;1&quot; data-index-in-node=&quot;22&quot; style=&quot;&quot;&gt;xuất sắc&lt;/b&gt; với mAP50 chạm mức &lt;b data-path-to-node=&quot;1&quot; data-index-in-node=&quot;50&quot; style=&quot;&quot;&gt;96,15%&lt;/b&gt; và mAP50-95 đạt &lt;b data-path-to-node=&quot;1&quot; data-index-in-node=&quot;73&quot; style=&quot;&quot;&gt;87,26%&lt;/b&gt;, thể hiện khả năng nhận diện và khoanh vùng vật thể cực kỳ chính xác. Chỉ số &lt;b data-path-to-node=&quot;1&quot; data-index-in-node=&quot;157&quot; style=&quot;&quot;&gt;F1-Score tối ưu (0.925)&lt;/b&gt; tại Epoch 67 cho thấy sự cân bằng hoàn hảo giữa Precision và Recall, trực tiếp khắc phục lỗi &quot;nhận diện nhầm&quot; (False Positive) thường gặp. Việc các đường Loss (Box, Cls, DFL) trên tập Val giảm đều và bám sát tập Train là minh chứng cho việc mô hình &lt;b data-path-to-node=&quot;1&quot; data-index-in-node=&quot;430&quot; style=&quot;&quot;&gt;không bị overfitting&lt;/b&gt; và có khả năng ứng dụng thực tế cao. Trọng số tại &lt;b data-path-to-node=&quot;1&quot; data-index-in-node=&quot;501&quot; style=&quot;&quot;&gt;Epoch 67&lt;/b&gt; là lựa chọn tốt nhất để triển khai vì độ ổn định cao và khung hình không bị rung lắc. Tổng thể, đây là mô hình đã hội tụ, đạt chuẩn để đưa vào các hệ thống giám sát giao thông thông minh.&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="1425" x="2729.1400000000003" y="3269.9300000000003" as="geometry" />
        </mxCell>
        <mxCell id="IWX-teLzkkFB8sVI0xB0-314" edge="1" parent="1" source="IWX-teLzkkFB8sVI0xB0-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;curved=1;strokeWidth=5;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="IWX-teLzkkFB8sVI0xB0-2">
