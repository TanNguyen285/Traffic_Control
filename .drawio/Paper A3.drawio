        <mxCell id="cTvlR5VofzseXJRwo90h-2" parent="1" style="text;whiteSpace=wrap;fontSize=15;fontFamily=Times New Roman;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="$$\begin{array}{|l|}&#xa;\hline&#xa;\text{Giai đoạn huấn luyện (Training Stage):} \\&#xa;\mathbf{y} = \text{BN} \left( \sum_{i} \text{Conv}_{\text{dilated}}(\mathbf{x}, W_i, r_i) \right) + \text{BN}(\text{Conv}_{1\times1}(\mathbf{x})) \\&#xa;\text{Giai đoạn suy diễn (Inference Stage):} \\&#xa;W&#39;_{i} = \text{conv\_transpose2d}(W_i, \mathbf{I}, \text{stride}=r_i) \\&#xa;W_{eq} = \sum_{i} W&#39;_{i} + \text{Pad}(W_{1\times1}) + \text{Fuse}(\text{BN}) \\&#xa;\mathbf{y} = \text{Conv}(\mathbf{x}, W_{eq}, \text{stride}=1) \\&#xa;\hline&#xa;\bullet \ \mathbf{x}, \mathbf{y}: \text{Đầu vào và đầu ra của khối Dilated Reparam} \\&#xa;\bullet \ W_i: \text{Trọng số của nhân tích chập nhánh thứ } i \\&#xa;\bullet \ r_i: \text{Tỷ lệ giãn (dilation rate) tương ứng với nhánh } i \\&#xa;\bullet \ \mathbf{I}: \text{Nhân đơn vị (Identity kernel) dùng để giãn trọng số} \\&#xa;\bullet \ W&#39;_{i}: \text{Nhân thưa đã được chuyển đổi thành nhân dày (dense)} \\&#xa;\bullet \ W_{eq}: \text{Nhân lớn tương đương cuối cùng sau khi gộp nhánh} \\&#xa;\bullet \ K: \text{Kích thước nhân mục tiêu (Target Kernel Size, e.g., 13)} \\&#xa;\hline&#xa;\end{array}$$" vertex="1">
          <mxGeometry height="293.28" width="420" x="-390" y="940" as="geometry" />
        </mxCell>
        <mxCell id="cTvlR5VofzseXJRwo90h-3" parent="1" style="text;whiteSpace=wrap;fontSize=17;fontFamily=Times New Roman;align=center;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="$$\begin{array}{l}&#xa;\text{Cơ chế DRB (Dilated Reparameterization) cho phép UniRepLKNet} \\&#xa;\text{tận dụng các nhân giãn để mở rộng vùng quan sát (ERF) mà không} \\&#xa;\text{làm tăng chi phí tính toán. Trong quá trình huấn luyện, cấu trúc} \\&#xa;\text{đa nhánh song song giúp lấp đầy các khoảng trống dữ liệu của} \\&#xa;\text{tích chập thưa (gridding artifacts). Khi suy diễn, toàn bộ các} \\&#xa;\text{nhánh và lớp BN được gộp toán học thành một nhân dày duy nhất,} \\&#xa;\text{đảm bảo tốc độ xử lý tối đa trong khi vẫn giữ được khả năng} \\&#xa;\text{trích xuất đặc trưng của các nhân siêu lớn (Large Kernels).}&#xa;\end{array}$$" vertex="1">
          <mxGeometry height="216.15" width="537" x="-767" y="1233.28" as="geometry" />
        </mxCell>
        <mxCell id="CJ67aPOnBUCLYqWHG5dM-1" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
