        <mxCell id="0N9hTULjjDuCIy-rGeN6-15" parent="1" style="text;whiteSpace=wrap;fontSize=21;fontFamily=Times New Roman;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="$$\begin{array}{|l|}&#xa;\hline&#xa;\textbf{PHÂN TÍCH CHIẾN LƯỢC THIẾT KẾ GLKA} \\&#xa;\hline&#xa;\textbf{Khối 1: Hiệu chỉnh Ngữ nghĩa Liên kênh (1D Channel Attention)} \\&#xa;\hline&#xa;\bullet \ \textbf{Tại sao:} \text{ Hoạt động dựa trên triết lý 1D, nén toàn bộ không gian để học} \\&#xa;\text{mối tương quan giữa các kênh đặc trưng. Mục tiêu là xác định &quot;Cái gì&quot; (What)} \\&#xa;\text{quan trọng, từ đó tái trọng số các kênh mang thông tin hữu ích.} \\&#xa;\bullet \ \textbf{Lợi ích:} \text{ Loại bỏ nhiễu ngữ nghĩa, giúp mạng tập trung vào các đặc trưng} \\&#xa;\text{cốt lõi của đối tượng mục tiêu bất kể vị trí của chúng trong ảnh.} \\&#xa;\hline&#xa;\textbf{Khối 2: Tương quan Không gian Đa thang đo (2D Spatial Awareness)} \\&#xa;\hline&#xa;\bullet \ \textbf{Tại sao:} \text{ Hoạt động trực tiếp trên mặt phẳng 2D. Sử dụng các nhân tích chập} \\&#xa;\text{giãn (Dilated Conv) song song để quét Receptive Field từ cục bộ đến toàn cục.} \\&#xa;\text{Cơ chế này xác định chính xác &quot;Ở đâu&quot; (Where) chứa thông tin cấu trúc.} \\&#xa;\bullet \ \textbf{Lợi ích:} \text{ Khắc phục hạn chế về kích thước vật thể biến thiên. Việc giữ nguyên} \\&#xa;\text{độ phân giải 2D giúp bảo toàn các chi tiết hình học cực nhỏ (Fine-grained).} \\&#xa;\hline&#xa;\textbf{Khối 3: Giao thoa Thứ bậc (Dimension Cross-Interaction)} \\&#xa;\hline&#xa;\bullet \ \textbf{Tại sao:} \text{ Phép nhân } \mathbf{F}_{anc} \otimes \mathbf{F}_{spa} \text{ tạo ra một bộ lọc &quot;AND Logic&quot; giữa 1D và 2D.} \\&#xa;\text{Một vùng đặc trưng chỉ được giữ lại nếu nó vừa có ý nghĩa về nội dung (Kênh)} \\&#xa;\text{vừa khớp với bối cảnh không gian đa thang đo (Vị trí).} \\&#xa;\bullet \ \textbf{Lợi ích:} \text{ Triệt tiêu tối đa các vùng &quot;báo động giả&quot; (False Positives), mang lại} \\&#xa;\text{độ chính xác vượt trội cho các mô hình phân loại và nhận diện phức tạp.} \\&#xa;\hline&#xa;\end{array}$$" vertex="1">
          <mxGeometry height="620" width="775" x="-745.48" y="1558" as="geometry" />
        </mxCell>
        <mxCell id="0N9hTULjjDuCIy-rGeN6-16" parent="1" style="text;whiteSpace=wrap;fontSize=25;fontFamily=Times New Roman;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="$$\begin{array}{|l|}&#xa;\hline&#xa;\textbf{HỆ THỐNG CÔNG THỨC MODULE GLKA} \\&#xa;\hline&#xa;\text{1. Tiền xử lý bối cảnh (Local Embedding):} \\&#xa;\mathbf{F}_{local} = \text{DW-Conv}_{5 \times 5}(\mathbf{F}) \\&#xa;\hline&#xa;\text{2. Nhánh Chú ý Kênh (1D Semantic Calibration):} \\&#xa;\mathbf{F}_{anc} = \mathbf{F}_{local} \otimes \text{SE}(\mathbf{F}_{local}) \\&#xa;\hline&#xa;\text{3. Nhánh Chú ý Không gian (2D Multi-scale Awareness):} \\&#xa;\mathbf{F}_{spa} = \sum_{d \in \{1, 2, 3\}} \text{BN}(\text{D-Conv}_{k, d}(\mathbf{F}_{local})) \\&#xa;\hline&#xa;\text{4. Hợp nhất thích nghi (Adaptive Fusion):} \\&#xa;\mathbf{F}_{out} = \mathbf{F}_{anc} \otimes \mathbf{F}_{spa} \\&#xa;\hline&#xa;\text{5. Hợp nhất triển khai (Structural Reparameterization):} \\&#xa;\text{Train: } \sum \text{D-Conv}_{d_i} \ \xrightarrow{\text{Inference}} \ \text{Test: } \text{Conv}_{13 \times 13}^{fused} \\&#xa;\hline&#xa;\end{array}$$" vertex="1">
          <mxGeometry height="460" width="660" x="70" y="1690" as="geometry" />
        </mxCell>
