        <mxCell id="zvTdW2XHT6xRna0pAbf5-23" edge="1" parent="1" style="endArrow=none;html=1;rounded=0;strokeWidth=3;fontSize=20;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
