        <mxCell id="S117_dqVFVA6YkVLDi6Q-3" connectable="0" parent="1" style="group" value="" vertex="1">
          <mxGeometry height="637.35" width="860" x="-730" y="70" as="geometry" />
        </mxCell>
        <mxCell id="UwMuXr-YGRhaxbXoSWXX-561" parent="S117_dqVFVA6YkVLDi6Q-3" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;align=left;" value="&lt;h3 data-path-to-node=&quot;11&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot; face=&quot;Times New Roman&quot;&gt;Tầng 3: Nhận diện và Phân loại chi tiết (Object Detection Layer)&lt;/font&gt;&lt;/h3&gt;&lt;h3 data-path-to-node=&quot;8&quot;&gt;&lt;p data-path-to-node=&quot;12&quot;&gt;&lt;font style=&quot;font-size: 25px; font-weight: normal;&quot; face=&quot;Times New Roman&quot;&gt;Sau khi có cái nhìn tổng quát, hệ thống đi vào phân tích chi tiết:&lt;/font&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;13&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;13,0,0&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot; face=&quot;Times New Roman&quot;&gt;&lt;span data-path-to-node=&quot;13,0,0&quot; data-index-in-node=&quot;0&quot; style=&quot;&quot;&gt;Phương pháp&lt;span style=&quot;font-weight: normal;&quot;&gt;:&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt; Triển khai mô hình &lt;/span&gt;&lt;span data-path-to-node=&quot;13,0,0&quot; data-index-in-node=&quot;32&quot; style=&quot;font-weight: normal;&quot;&gt;YOLOv26&lt;/span&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt; được biên dịch qua framework &lt;/span&gt;&lt;span data-path-to-node=&quot;13,0,0&quot; data-index-in-node=&quot;69&quot; style=&quot;font-weight: normal;&quot;&gt;NCNN&lt;/span&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;.&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;13,1,0&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot; face=&quot;Times New Roman&quot;&gt;&lt;span data-path-to-node=&quot;13,1,0&quot; data-index-in-node=&quot;0&quot; style=&quot;line-height: 90%;&quot;&gt;Nhiệm vụ&lt;span style=&quot;font-weight: normal;&quot;&gt;:&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt; Định danh và đếm số lượng cụ thể từng loại phương tiện (xe máy, ô tô, xe tải).&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;13,2,0&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot; face=&quot;Times New Roman&quot;&gt;&lt;span data-path-to-node=&quot;13,2,0&quot; data-index-in-node=&quot;0&quot; style=&quot;&quot;&gt;Vai trò&lt;span style=&quot;font-weight: normal;&quot;&gt;:&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt; Dữ liệu từ tầng này dùng để tinh chỉnh thời gian đèn xanh khi mật độ giao thông ở mức trung bình và thấp.&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="280" width="860" as="geometry" />
        </mxCell>
        <UserObject label="&lt;div style=&quot;line-height: 110%;&quot;&gt;&lt;p data-path-to-node=&quot;4&quot;&gt;&lt;span data-path-to-node=&quot;4&quot; data-index-in-node=&quot;0&quot;&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 25px; line-height: 110%;&quot;&gt;&amp;nbsp; &amp;nbsp; Điểm mấu chốt của lựa chọn này:&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,0&quot;&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 25px; line-height: 110%;&quot;&gt;&lt;span data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;0&quot;&gt;&lt;b&gt;Tốc độ&lt;/b&gt;:&lt;/span&gt; Thời gian xử lý mỗi ảnh cực thấp&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,0&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;span data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-size: 25px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 110%;&quot;&gt;&lt;b&gt;Tối ưu&lt;/b&gt;:&lt;/span&gt;&lt;span style=&quot;font-size: 25px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 110%;&quot;&gt; NCNN được thiết kế riêng cho chip di động và máy tính nhúng.&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,2,0&quot;&gt;&lt;span style=&quot;font-size: 25px; font-family: &amp;quot;Times New Roman&amp;quot;; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Loại bỏ DFL&lt;/b&gt;: Đơn giản hóa xuất và mở rộng khả năng tương thích edge&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 25px; line-height: 110%;&quot;&gt;&lt;b&gt;NMS-Free&lt;/b&gt;: Loại bỏ NMS để triển khai nhanh hơn, đơn giản hơn&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 25px; line-height: 110%;&quot;&gt;&lt;b&gt;ProgLoss + STAL&lt;/b&gt;: Tăng độ chính xác, đặc biệt là trên các vật thể nhỏ&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 25px; line-height: 110%;&quot;&gt;&lt;b&gt;Trình tối ưu hóa MuSGD&lt;/b&gt;: Kết hợp SGD và Muon (lấy cảm hứng từ Kimi K2 của Moonshot) để huấn luyện ổn định và hiệu quả hơn&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 25px; line-height: 110%;&quot;&gt;Suy luận CPU nhanh hơn tới 43%: Cải thiện hiệu suất đáng kể cho các thiết bị chỉ có CPU&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/p&gt;&lt;p data-path-to-node=&quot;5,2,0&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;line-height: 100%; font-size: 25px;&quot; face=&quot;Times New Roman&quot;&gt;&lt;/font&gt;&lt;/p&gt;&lt;/div&gt;" link="https://arxiv.org/pdf/2601.12882" id="UwMuXr-YGRhaxbXoSWXX-564">
          <mxCell parent="S117_dqVFVA6YkVLDi6Q-3" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=default;" vertex="1">
