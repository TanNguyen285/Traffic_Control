        <mxCell id="UwMuXr-YGRhaxbXoSWXX-398" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;" value="&lt;i style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;Hình 3 : Kết quả sau tiền xử lý&lt;/font&gt;&lt;/i&gt;" vertex="1">
