        <mxCell id="ttxaoflBST3eKpaZsT9E-1" parent="1" style="text;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=3;fillColor=none;rounded=0;glass=0;" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Metric&lt;/font&gt;&lt;/th&gt;&lt;th&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/th&gt;&lt;th&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Loại đánh giá&lt;/font&gt;&lt;/th&gt;&lt;th&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Hướng tốt&lt;/font&gt;&lt;/th&gt;&lt;th&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Phản ánh điều gì&lt;/font&gt;&lt;/th&gt;&lt;th&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Diễn giải ngắn gọn&lt;/font&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;PSNR&lt;/font&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Peak Signal-to-Noise Ratio&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Full-reference&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;↑ Cao&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Độ sai khác pixel so với ảnh chuẩn&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Càng cao → ảnh càng gần ground-truth&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;SSIM&lt;/font&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Structural Similarity Index&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Full-reference&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;↑ Cao&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Mức bảo toàn cấu trúc, texture&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Càng cao → giữ cấu trúc càng tốt&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;DE&lt;/font&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Detail Enhancement&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;No-reference&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;↑ Cao&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Mức tăng chi tiết&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Càng cao → chi tiết rõ hơn&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;EME&lt;/font&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Enhancement Measure Estimation&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;No-reference&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;↑ Cao&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Độ cải thiện tương phản cục bộ&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Càng cao → tương phản mạnh hơn&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;LOE&lt;/font&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Lightness Order Error&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;No-reference&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;↓ Thấp&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Sai lệch thứ tự sáng tối tự nhiên&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Càng thấp → ánh sáng tự nhiên hơn&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;NIQE&lt;/font&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Natural Image Quality Evaluator&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;No-reference&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;↓ Thấp&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Độ tự nhiên thống kê của ảnh&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 21px;&quot; face=&quot;Times New Roman&quot;&gt;Càng thấp → ảnh nhìn tự nhiên hơn&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
