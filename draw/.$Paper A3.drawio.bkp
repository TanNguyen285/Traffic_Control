        <mxCell id="IDHXjdb-JRifpkvbcr10-311" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=Helvetica;fontSize=20;fontColor=default;align=left;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;h3 data-path-to-node=&quot;8&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot; style=&quot;font-size: 15px; background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;Tầng 2: Phân tích mật độ tổng quát (SimpleCNN)&lt;/font&gt;&lt;/h3&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px; background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;span style=&quot;color: rgb(48, 48, 48); font-family: &amp;quot;Google Sans Text&amp;quot;; font-weight: 700; white-space-collapse: preserve;&quot;&gt;Large Kernel Attention (LKA)&lt;/span&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;h3 data-path-to-node=&quot;6&quot;&gt;&lt;p data-path-to-node=&quot;9&quot;&gt;&lt;font style=&quot;font-size: 15px; background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;span data-start-index=&quot;273&quot; class=&quot;ng-star-inserted&quot; style=&quot;color: rgb(48, 48, 48); font-family: &amp;quot;Google Sans Text&amp;quot;; font-weight: 400; white-space-collapse: preserve;&quot;&gt;Triết lý cốt lõi của LKA là &lt;/span&gt;&lt;b data-start-index=&quot;301&quot; class=&quot;ng-star-inserted&quot; style=&quot;color: rgb(48, 48, 48); font-family: &amp;quot;Google Sans Text&amp;quot;; white-space-collapse: preserve;&quot;&gt;kết hợp ưu điểm của cả Tích chập (Convolution) và Tự chú ý (Self-Attention)&lt;/b&gt;&lt;span data-start-index=&quot;376&quot; class=&quot;ng-star-inserted&quot; style=&quot;color: rgb(48, 48, 48); font-family: &amp;quot;Google Sans Text&amp;quot;; font-weight: 400; white-space-collapse: preserve;&quot;&gt; trong khi khắc phục các nhược điểm của chúng&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-path-to-node=&quot;9&quot;&gt;&lt;span data-start-index=&quot;376&quot; class=&quot;ng-star-inserted&quot; style=&quot;color: rgb(48, 48, 48); font-family: &amp;quot;Google Sans Text&amp;quot;; font-weight: 400; white-space-collapse: preserve; background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-start-index=&quot;422&quot; class=&quot;ng-star-inserted&quot;&gt;Kế thừa từ Convolution:&lt;/b&gt;&lt;span data-start-index=&quot;445&quot; class=&quot;ng-star-inserted&quot;&gt; Khả năng tận dụng thông tin cấu trúc cục bộ và tính hiệu quả nhờ chia sẻ trọng số&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p data-path-to-node=&quot;9&quot;&gt;&lt;span data-start-index=&quot;376&quot; class=&quot;ng-star-inserted&quot; style=&quot;color: rgb(48, 48, 48); font-family: &amp;quot;Google Sans Text&amp;quot;; font-weight: 400; white-space-collapse: preserve;&quot;&gt;&lt;span data-start-index=&quot;445&quot; class=&quot;ng-star-inserted&quot; style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-start-index=&quot;528&quot; class=&quot;ng-star-inserted&quot;&gt;Kế thừa từ Self-Attention:&lt;/b&gt;&lt;span data-start-index=&quot;554&quot; class=&quot;ng-star-inserted&quot;&gt; Khả năng thiết lập các mối quan hệ tầm xa (long-range dependence) và tính thích nghi (adaptability) theo dữ liệu đầu vào&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p data-path-to-node=&quot;9&quot;&gt;&lt;span data-start-index=&quot;376&quot; class=&quot;ng-star-inserted&quot; style=&quot;color: rgb(48, 48, 48); font-family: &amp;quot;Google Sans Text&amp;quot;; font-weight: 400; white-space-collapse: preserve;&quot;&gt;&lt;span data-start-index=&quot;445&quot; class=&quot;ng-star-inserted&quot; style=&quot;&quot;&gt;&lt;span data-start-index=&quot;554&quot; class=&quot;ng-star-inserted&quot; style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-start-index=&quot;676&quot; class=&quot;ng-star-inserted&quot; style=&quot;&quot;&gt;Khắc phục:&lt;/b&gt;&lt;span data-start-index=&quot;686&quot; class=&quot;ng-star-inserted&quot; style=&quot;&quot;&gt; Tránh độ phức tạp tính toán bậc hai (&lt;/span&gt;&lt;span class=&quot;ng-star-inserted&quot; style=&quot;&quot;&gt;&lt;span class=&quot;katex&quot; style=&quot;font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-variant-emoji: normal; font-stretch: normal; line-height: 1.2; font-family: KaTeX_Main, &amp;quot;Times New Roman&amp;quot;, serif; text-rendering: auto;&quot;&gt;&lt;span class=&quot;katex-html&quot; aria-hidden=&quot;true&quot; style=&quot;border-color: currentcolor;&quot;&gt;&lt;span class=&quot;base&quot; style=&quot;border-color: currentcolor; position: relative; white-space: nowrap; width: min-content; display: inline-block;&quot;&gt;&lt;span class=&quot;strut&quot; style=&quot;border-color: currentcolor; display: inline-block; height: 1.0641em; vertical-align: -0.25em;&quot;&gt;&lt;/span&gt;&lt;span class=&quot;mord mathnormal&quot; style=&quot;border-color: currentcolor; font-family: KaTeX_Math; font-style: italic; margin-right: 0.0278em;&quot;&gt;O&lt;/span&gt;&lt;span class=&quot;mopen&quot; style=&quot;border-color: currentcolor;&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;mord&quot; style=&quot;border-color: currentcolor;&quot;&gt;&lt;span class=&quot;mord mathnormal&quot; style=&quot;border-color: currentcolor; font-family: KaTeX_Math; font-style: italic;&quot;&gt;n&lt;/span&gt;&lt;span class=&quot;msupsub&quot; style=&quot;border-color: currentcolor;&quot;&gt;&lt;span class=&quot;vlist-t&quot; style=&quot;border-color: currentcolor; border-collapse: collapse; display: inline-table; table-layout: fixed;&quot;&gt;&lt;span class=&quot;vlist-r&quot; style=&quot;border-color: currentcolor; display: table-row;&quot;&gt;&lt;span class=&quot;vlist&quot; style=&quot;border-color: currentcolor; display: table-cell; position: relative; vertical-align: bottom; height: 0.8141em;&quot;&gt;&lt;span class=&quot;&quot; style=&quot;border-color: currentcolor; display: block; height: 0px; position: relative; top: -3.063em; margin-right: 0.05em;&quot;&gt;&lt;span class=&quot;pstrut&quot; style=&quot;border-color: currentcolor; display: inline-block; overflow: hidden; width: 0px; height: 2.7em;&quot;&gt;&lt;/span&gt;&lt;span class=&quot;sizing reset-size6 size3 mtight&quot; style=&quot;border-color: currentcolor; display: inline-block;&quot;&gt;&lt;span class=&quot;mord mtight&quot; style=&quot;border-color: currentcolor;&quot;&gt;2&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;mclose&quot; style=&quot;border-color: currentcolor;&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span data-start-index=&quot;730&quot; class=&quot;ng-star-inserted&quot; style=&quot;&quot;&gt;) của Self-Attention và sự thiếu linh hoạt (trọng số tĩnh) của tích chập tiêu chuẩn&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;/h3&gt;" vertex="1">
