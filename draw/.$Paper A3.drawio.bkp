        <mxCell id="zvTdW2XHT6xRna0pAbf5-11" parent="1" style="text;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;fontSize=20;align=center;" value="&lt;font style=&quot;font-size: 15px; background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;Attention = Conv1×1(DW-D-Conv(DW-Conv(F)))&amp;nbsp;&lt;br&gt;Output = Attention ⊗F.&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="63.23" width="340" x="-680" y="296.77" as="geometry" />
        </mxCell>
        <mxCell id="zvTdW2XHT6xRna0pAbf5-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;fontSize=20;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;$$F \in \mathbb{R}^{C \times H \times W}$$&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="160" x="-294.57" y="290" as="geometry" />
        </mxCell>
        <mxCell id="zvTdW2XHT6xRna0pAbf5-14" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;fontSize=20;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;$$Attention \in \mathbb{R}^{C \times H \times W}$$&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="210" x="-310" y="330" as="geometry" />
        </mxCell>
        <mxCell id="zvTdW2XHT6xRna0pAbf5-21" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=20;align=left;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;Here, F ∈ RC×H×W is the input feature. Attention ∈ RC×H×W denotes attention map. The value in attention map indicates the importance of each feature. ⊗ means element-wise product. Different from common attention methods&lt;/font&gt;" vertex="1">
          <mxGeometry height="103.07" width="740.97" x="-750.97" y="406.93" as="geometry" />
        </mxCell>
        <mxCell id="zvTdW2XHT6xRna0pAbf5-23" edge="1" parent="1" style="endArrow=none;html=1;rounded=0;strokeWidth=3;fontSize=20;" value="">
