        <mxCell id="UwMuXr-YGRhaxbXoSWXX-366" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/jpeg,;clipPath=inset(23.29% 13.35% 24.57% 10.68%);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
