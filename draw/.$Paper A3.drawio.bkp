        <mxCell id="Ny-ZXVUuPNYQ5GdCGsUl-234" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/jpeg,;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;fontSize=14;" value="" vertex="1">
          <mxGeometry height="171" width="171" x="-511" y="2075.5" as="geometry" />
