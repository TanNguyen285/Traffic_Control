        <mxCell id="UwMuXr-YGRhaxbXoSWXX-403" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;align=left;" value="&lt;h3 data-path-to-node=&quot;8&quot;&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 25px;&quot;&gt;Tầng 2: Phân tích mật độ tổng quát (Traffic Density Analysis Layer)&lt;/font&gt;&lt;/h3&gt;&lt;h3 data-path-to-node=&quot;6&quot;&gt;&lt;p data-path-to-node=&quot;9&quot;&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 25px; font-weight: normal;&quot;&gt;Thay vì đi thẳng vào nhận diện, hệ thống thực hiện đánh giá mức độ ưu tiên trước:&lt;/font&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;10&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;10,0,0&quot;&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 25px; font-weight: normal;&quot;&gt;&lt;span data-path-to-node=&quot;10,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Phương pháp:&lt;/span&gt; Sử dụng thuật toán &lt;span data-path-to-node=&quot;10,0,0&quot; data-index-in-node=&quot;32&quot;&gt;Area Occupancy&lt;/span&gt; (Tính tỷ lệ chiếm dụng diện tích).&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;10,1,0&quot;&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 25px; font-weight: normal;&quot;&gt;&lt;span data-path-to-node=&quot;10,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Nhiệm vụ:&lt;/span&gt; Hệ thống quét vùng ROI để tính toán tỷ lệ phần trăm các pixel thay đổi so với nền đường tĩnh.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;10,2,0&quot;&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 25px; font-weight: normal;&quot;&gt;&lt;span data-path-to-node=&quot;10,2,0&quot; data-index-in-node=&quot;0&quot; style=&quot;&quot;&gt;Vai trò:&lt;/span&gt; Nếu kết quả cho thấy đường đang &lt;span data-path-to-node=&quot;10,2,0&quot; data-index-in-node=&quot;41&quot; style=&quot;&quot;&gt;&quot;Nghẹt&quot; (Congestion)&lt;/span&gt; vượt ngưỡng, hệ thống sẽ kích hoạt ngay chế độ &quot;Xả trạm&quot; mà không cần đợi kết quả nhận diện chi tiết (giảm tải cho CPU).&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/h3&gt;" vertex="1">
