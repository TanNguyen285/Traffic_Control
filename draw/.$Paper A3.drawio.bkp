        </mxCell>
        <mxCell id="ttxaoflBST3eKpaZsT9E-217" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;align=left;" value="&lt;div&gt;&lt;h3 data-path-to-node=&quot;6&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot; face=&quot;Times New Roman&quot;&gt;&amp;nbsp;Tầng 1: Tiền xử lý dữ liệu (Image Pre-processing Layer)&lt;/font&gt;&lt;/h3&gt;&lt;h2 data-path-to-node=&quot;3&quot;&gt;&lt;ul data-path-to-node=&quot;7&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;7,0,0&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot; face=&quot;Times New Roman&quot;&gt;&lt;span data-path-to-node=&quot;7,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Phương pháp:&lt;/span&gt; Sử dụng mạng &lt;span data-path-to-node=&quot;7,0,0&quot; data-index-in-node=&quot;26&quot;&gt;Zero-DCE++&lt;/span&gt;.&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;7,1,0&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot; face=&quot;Times New Roman&quot;&gt;&lt;span data-path-to-node=&quot;7,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Nhiệm vụ:&lt;/span&gt; Đây là bước &quot;làm sạch&quot; dữ liệu. Video đầu vào từ Camera được hiệu chỉnh ánh sáng động để loại bỏ nhiễu và tăng độ tương phản. Bước này cực kỳ quan trọng để các thuật toán đo đạc ở tầng sau không bị sai lệch do điều kiện thời tiết hoặc ánh sáng yếu .&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/h2&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="1090" x="750" y="1570" as="geometry" />
        </mxCell>
        <mxCell id="ttxaoflBST3eKpaZsT9E-218" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;" value="&lt;i style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;Hình 2 : Xử lý ảnh vào RGB&lt;/font&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="30" width="380" x="860" y="2099" as="geometry" />
        </mxCell>
        <mxCell id="ttxaoflBST3eKpaZsT9E-219" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;" value="&lt;i style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;Hình 3 : Kết quả sau tiền xử lý&lt;/font&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="30" width="380" x="1530" y="2110" as="geometry" />
        </mxCell>
        <mxCell id="ttxaoflBST3eKpaZsT9E-220" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;" value="&lt;div style=&quot;line-height: 100%;&quot;&gt;&lt;p data-path-to-node=&quot;4&quot;&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 25px; line-height: 100%;&quot;&gt;&lt;span data-path-to-node=&quot;4&quot; data-index-in-node=&quot;0&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Zero-DCE++&lt;/span&gt; (Zero-Reference Deep Curve Estimation) là một mạng học sâu được thiết kế để tăng cường hình ảnh thiếu sáng mà &lt;span data-path-to-node=&quot;4&quot; data-index-in-node=&quot;121&quot;&gt;không cần dữ liệu tham chiếu&lt;/span&gt; (tức là không cần ảnh &quot;đẹp&quot; có sẵn để so sánh trong quá trình học).&lt;/font&gt;&lt;/p&gt;&lt;p data-path-to-node=&quot;5&quot;&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 25px; line-height: 100%;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Thay vì trực tiếp thay đổi giá trị pixel, DCE++ học cách ước tính các &lt;span data-path-to-node=&quot;5&quot; data-index-in-node=&quot;70&quot;&gt;đường cong điều chỉnh ánh sáng (Light-Enhancement curves)&lt;/span&gt;. Nó giống như việc AI tự động điều chỉnh các thanh gạt &quot;Curves&quot; trong Photoshop cho từng pixel một cách thông minh.&lt;/font&gt;&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="720" x="1350" y="2150" as="geometry" />
        </mxCell>
