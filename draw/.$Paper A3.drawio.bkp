        <mxCell id="l-Hj1fhEkQFJPHOCS-Hp-3" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;li style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;p data-path-to-node=&quot;4,0,0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;b data-path-to-node=&quot;4,0,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Độ thưa tích lũy (Requirement):&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;div data-path-to-node=&quot;4,0,1&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;div class=&quot;math-block&quot; data-math=&quot;\text{Lớp cuối (n): } M_n = r_n&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;$$\text{Lớp cuối (n): } M_n = r_n$$&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div data-path-to-node=&quot;4,0,2&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;div class=&quot;math-block&quot; data-math=&quot;\text{Lớp trước (i): } M_i = \max(M_{i+1} - 2r_i, \ M_{i+1} - 2(M_{i+1} - r_i), \ r_i)&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;$$\text{Lớp trước (i): } M_i = \max(M_{i+1} - 2r_i, \ M_{i+1} - 2(M_{i+1} - r_i), \ r_i)$$&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;&lt;li style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;p data-path-to-node=&quot;4,1,0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;b data-path-to-node=&quot;4,1,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Điều kiện bao phủ (Capability):&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;div data-path-to-node=&quot;4,1,1&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;div class=&quot;math-block&quot; data-math=&quot;M_2 \leq K_1&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;$$M_2 \leq K_1$$&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;" vertex="1">
